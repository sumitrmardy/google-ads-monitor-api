        "jsCode": "const ads = $input.all().map(i => i.json);\nlet html = '<h2>Weekly Competitor Ads Intelligence Digest</h2><ul>';\nfor (const ad of ads) {\n  html += `<li><b>${ad.advertiserName || ad.target}</b> (${ad.format}): ${ad.headline || 'No headline'} — <a href=\"${ad.adUrl}\">View Ad</a></li>`;\n}\nhtml += '</ul>';\nreturn [{ json: { html, total: ads.length } }];"
      },
